GEMINI_API_KEY=
# Chosen for availability and lower rate-limit pressure than Gemini 3.7.
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered failover chain for quota/overload errors (primary first, next on 429/503).
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Extra plain-text fallbacks (Gemma, free tier) for bare-JSON calls only;
# audio, structured schema, and search grounding stay on the Flash chain.
GEMINI_MODEL_FALLBACKS_PLAIN=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_MOCK_MODE=false
# Set MCP_MOCK_MODE=false after Silpo OAuth is configured for live catalog/cart calls.
# Voice replies are generated by Respeecher when RESPEECHER_API_KEY is set.
TTS_ENABLED=true
TTS_MOCK_MODE=false
TTS_PROVIDER=respeecher
RESPEECHER_API_KEY=
RESPEECHER_VOICE_ID=olesia-conversation
RESPEECHER_MODEL=ua-rt
MCP_MOCK_MODE=true
OPENAI_API_KEY=
LOG_LEVEL=INFO
