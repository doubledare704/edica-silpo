{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Backend: uvicorn",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"uvicorn",
				"backend.app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "uvicorn",
				"pattern": {
					"regexp": ".*"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Uvicorn running on http://127\\.0\\.0\\.1:8000"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": false
			},
			"group": "build"
		},
		{
			"label": "Frontend: Vite",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev", "--prefix", "frontend"],
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": ".*"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Local:.*"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": false
			},
			"group": "build"
		},
		{
			"label": "Dev: backend + frontend",
			"dependsOn": ["Backend: uvicorn", "Frontend: Vite"],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Validation: Python gate",
			"type": "shell",
			"command": "uv run ruff format . && uv run ruff check . && uv run pyrefly check && uv run pytest backend/tests",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"group": "test"
		}
	]
}